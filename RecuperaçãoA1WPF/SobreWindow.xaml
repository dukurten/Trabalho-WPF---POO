<Window x:Class="RecuperaçãoA1WPF.SobreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre" Height="330" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="#F3F5F9">
        <Border Background="White" CornerRadius="14" Padding="30" Margin="24">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sobre a aplicação" FontSize="25" FontWeight="Bold"
                           Foreground="#23395B" Margin="0,0,0,22"/>
                <TextBlock Text="Avaliação 1 — Programação Orientada a Objetos II"
                           TextWrapping="Wrap" FontSize="15" Margin="0,4"/>
                <TextBlock Text="Desenvolvedor: Eduardo Kurten Grose" FontSize="15" Margin="0,8"/>
                <TextBlock Text="Turma: 4º Periodo - TADS" FontSize="15" Margin="0,4"/>
                <TextBlock Text="Ano: 2026" FontSize="15" Margin="0,4"/>
                <Button Content="Fechar" Height="40" Margin="0,24,0,0" Click="Fechar_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
