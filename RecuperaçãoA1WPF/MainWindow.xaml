<Window x:Class="RecuperaçãoA1WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avaliação 1 - POO II" Height="390" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="#F3F5F9">
        <Border Background="White" CornerRadius="14" Padding="30" Margin="28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Avaliação 1" FontSize="28" FontWeight="Bold"
                           Foreground="#23395B" HorizontalAlignment="Center" />
                <TextBlock Text="Programação Orientada a Objetos II" FontSize="14"
                           Foreground="#65748B" Margin="0,6,0,24"
                           HorizontalAlignment="Center" />
                <Button Content="Atividade 1 — Salário com bonificação" Height="44"
                        Margin="0,5" Click="Atividade1_Click"/>
                <Button Content="Atividade 2 — Média ponderada" Height="44"
                        Margin="0,5" Click="Atividade2_Click"/>
                <Button Content="Sobre" Height="44" Margin="0,5" Click="Sobre_Click"/>
                <Button Content="Sair" Height="44" Margin="0,5" Click="Sair_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>